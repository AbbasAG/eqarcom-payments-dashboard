rules_version = '2';

// Firestore Security Rules for EQARCOM Dashboard
// Deploy via Firebase Console > Firestore > Rules, or via Firebase CLI
//
// These rules prevent users from escalating their own permissions.
// Only the admin (abbas.hayat@al-ghurair.com) can modify user documents.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──
    match /users/{email} {

      // Allow reads — needed for registration lookup (before user is authenticated)
      // User docs contain name, email, and permission flags — no secrets
      allow read: if true;

      // Admin has full write access to all user documents
      allow write: if request.auth != null
                   && request.auth.token.email == 'abbas.hayat@al-ghurair.com';

      // Users can update ONLY safe fields on their own document:
      //   registered, uid  — set during registration
      //   lastVisited      — set on each login
      // Cannot change: isAdmin, payments, serviceBookings, managementDashboard,
      //                allowedOrgs, enabled, name, email
      allow update: if request.auth != null
                    && request.auth.token.email == email
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['registered', 'uid', 'lastVisited']);
    }

    // ── Deny everything else by default ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
