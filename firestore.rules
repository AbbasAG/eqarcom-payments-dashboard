rules_version = '2';

// Firestore Security Rules for EQARCOM Dashboard
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users collection ──
    match /users/{email} {

      // Single-doc reads (`get`) are permitted for the registration
      // lookup flow, which must run before the user can authenticate.
      // Collection enumeration (`list`) is restricted to admins to
      // prevent user roster harvesting.
      allow get:  if true;
      allow list: if request.auth != null
                  && request.auth.token.email == 'abbas.hayat@al-ghurair.com';

      // Admin has full write access to all user documents.
      allow write: if request.auth != null
                   && request.auth.token.email == 'abbas.hayat@al-ghurair.com';

      // Users can update ONLY safe fields on their own document:
      //   registered, uid  — set during registration
      //   lastVisited      — set on each login
      // Cannot change: isAdmin, payments, serviceBookings, managementDashboard,
      //                allowedOrgs, enabled, name, email
      allow update: if request.auth != null
                    && request.auth.token.email == email
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['registered', 'uid', 'lastVisited']);
    }

    // ── Deny everything else by default ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
