rules_version = '2';

// Firebase Cloud Storage Security Rules — EQARCOM Dashboard
// Deploy with:  firebase deploy --only storage
//
// All sensitive data extracts live under /private/.
// Reads are gated by the same permission flags as the dashboards
// (mirrors users/{email} doc in Firestore). Writes are admin-only.

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helpers ────────────────────────────────────────────────
    function userDoc() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.token.email)
      ).data;
    }
    // Email verification is not enforced by the registration flow,
    // and users are admin-provisioned, so a valid auth token is sufficient.
    function isSignedIn()  { return request.auth != null && request.auth.token.email != null; }
    function isEnabled()   { return isSignedIn() && userDoc().enabled == true; }
    function isAdmin()     { return isEnabled() && userDoc().isAdmin == true; }
    function hasPayments() { return isEnabled() && (isAdmin() || userDoc().payments != false); }
    function hasBookings() { return isEnabled() && (isAdmin() || userDoc().serviceBookings != false); }
    function hasOverview() { return isEnabled() && (isAdmin() || userDoc().managementDashboard == true); }

    // Management Overview is additionally scoped per organisation.
    // users/{email}.managementOrgs is a list of org ids the user may read.
    // Admins bypass the check. A user with no managementOrgs field set is
    // treated as legacy single-org and may read the default org only.
    function hasOverviewOrg(orgId) {
      return isAdmin() || (
        hasOverview() && (
          (userDoc().keys().hasAny(['managementOrgs'])
            && userDoc().managementOrgs is list
            && userDoc().managementOrgs.hasAny([orgId]))
          || (!userDoc().keys().hasAny(['managementOrgs']) && orgId == 'eqarat')
        )
      );
    }

    // Reasonable upload-size cap to prevent storage abuse (50 MB)
    function isReasonableSize() { return request.resource.size < 50 * 1024 * 1024; }

    // ─── Sensitive data extracts ────────────────────────────────
    // data.json   — payments + service-booking records (used by Payments + Service Bookings dashboards)
    match /private/data.json {
      allow read:  if hasPayments() || hasBookings();
      allow write: if isAdmin() && isReasonableSize()
                   && request.resource.contentType.matches('application/json.*');
    }

    // tickets.json — maintenance ticket records (used by Service Bookings dashboard)
    match /private/tickets.json {
      allow read:  if hasBookings();
      allow write: if isAdmin() && isReasonableSize()
                   && request.resource.contentType.matches('application/json.*');
    }

    // ─── Management Overview: one extract per organisation ──────
    // private/overview/{orgId}/data.json — units / leases for that org.
    // Read requires the Management Overview permission AND membership of
    // that specific organisation.
    match /private/overview/{orgId}/data.json {
      allow read:  if hasOverviewOrg(orgId);
      allow write: if isAdmin() && isReasonableSize()
                   && request.resource.contentType.matches('application/json.*');
    }

    // eqarat_data.js — LEGACY single-org units / leases extract.
    // Retained as a read-only fallback for the default org until the
    // per-org file above has been uploaded. Safe to delete afterwards.
    match /private/eqarat_data.js {
      allow read:  if hasOverviewOrg('eqarat');
      allow write: if isAdmin() && isReasonableSize();
    }

    // ─── Default deny ───────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
